rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidCategory(category) {
      return category is string &&
        category.size() >= 1 &&
        category.size() <= 32 &&
        category in ['DEEP_WORK', 'STUDY', 'CODING', 'READING', 'CREATIVE', 'OTHER'];
    }

    function isValidSessionType(sessionType) {
      return sessionType is string &&
        sessionType.size() >= 1 &&
        sessionType.size() <= 32 &&
        sessionType in ['FOCUS', 'SHORT_BREAK', 'LONG_BREAK'];
    }

    function isValidDateKey(dateKey) {
      return dateKey is string &&
        dateKey.size() == 10 &&
        dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---
    function isValidUserProfile(data, userId) {
      return data.userId is string &&
        data.userId.size() >= 1 &&
        data.userId.size() <= 128 &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 80 &&
        data.focusMinutes is int &&
        data.focusMinutes >= 1 &&
        data.focusMinutes <= 120 &&
        data.shortBreakMinutes is int &&
        data.shortBreakMinutes >= 1 &&
        data.shortBreakMinutes <= 60 &&
        data.longBreakMinutes is int &&
        data.longBreakMinutes >= 1 &&
        data.longBreakMinutes <= 60 &&
        data.dailyGoalMinutes is int &&
        data.dailyGoalMinutes >= 15 &&
        data.dailyGoalMinutes <= 720 &&
        data.hapticsEnabled is bool &&
        data.autoStartBreak is bool &&
        data.createdAt is timestamp &&
        data.createdAt <= request.time &&
        data.updatedAt is timestamp &&
        data.updatedAt <= request.time;
    }

    function isValidFocusSession(data, userId) {
      return data.userId is string &&
        data.userId.size() >= 1 &&
        data.userId.size() <= 128 &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 120 &&
        isValidCategory(data.category) &&
        data.durationMinutes is int &&
        data.durationMinutes >= 1 &&
        data.durationMinutes <= 180 &&
        isValidSessionType(data.sessionType) &&
        isValidDateKey(data.dateKey) &&
        (!('taskId' in data) || data.taskId == null || isValidId(data.taskId)) &&
        data.createdAt is timestamp &&
        data.createdAt <= request.time;
    }

    function isValidFocusTask(data, userId) {
      return data.userId is string &&
        data.userId.size() >= 1 &&
        data.userId.size() <= 128 &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 120 &&
        isValidCategory(data.category) &&
        data.estimatedPomodoros is int &&
        data.estimatedPomodoros >= 1 &&
        data.estimatedPomodoros <= 20 &&
        data.completedPomodoros is int &&
        data.completedPomodoros >= 0 &&
        data.completedPomodoros <= 100 &&
        data.completed is bool &&
        data.createdAt is timestamp &&
        data.createdAt <= request.time &&
        data.updatedAt is timestamp &&
        data.updatedAt <= request.time;
    }

    // --- COLLECTION RULES ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        incoming().keys().hasAll([
          'userId',
          'displayName',
          'focusMinutes',
          'shortBreakMinutes',
          'longBreakMinutes',
          'dailyGoalMinutes',
          'hapticsEnabled',
          'autoStartBreak',
          'createdAt',
          'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'userId',
          'displayName',
          'focusMinutes',
          'shortBreakMinutes',
          'longBreakMinutes',
          'dailyGoalMinutes',
          'hapticsEnabled',
          'autoStartBreak',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'focusMinutes',
          'shortBreakMinutes',
          'longBreakMinutes',
          'dailyGoalMinutes',
          'hapticsEnabled',
          'autoStartBreak',
          'updatedAt'
        ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      // Append-only completed focus sessions
      match /sessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(sessionId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
          isValidId(sessionId) &&
          incoming().keys().hasAll([
            'userId',
            'title',
            'category',
            'durationMinutes',
            'sessionType',
            'dateKey',
            'createdAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId',
            'title',
            'category',
            'durationMinutes',
            'sessionType',
            'dateKey',
            'taskId',
            'createdAt'
          ]) &&
          isValidFocusSession(incoming(), userId);

        allow update: if false;

        allow delete: if isOwner(userId) && isValidId(sessionId);
      }

      // User Pomodoro tasks
      match /tasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(taskId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
          isValidId(taskId) &&
          incoming().keys().hasAll([
            'userId',
            'title',
            'category',
            'estimatedPomodoros',
            'completedPomodoros',
            'completed',
            'createdAt',
            'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId',
            'title',
            'category',
            'estimatedPomodoros',
            'completedPomodoros',
            'completed',
            'createdAt',
            'updatedAt'
          ]) &&
          isValidFocusTask(incoming(), userId);

        allow update: if isOwner(userId) &&
          isValidId(taskId) &&
          isValidFocusTask(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          (
            // Action: Edit task details
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title',
              'category',
              'estimatedPomodoros',
              'updatedAt'
            ]) ||
            // Action: Toggle completion status
            incoming().diff(existing()).affectedKeys().hasOnly([
              'completed',
              'updatedAt'
            ]) ||
            // Action: Increment completed pomodoros on session finish
            (
              incoming().completedPomodoros == existing().completedPomodoros + 1 &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'completedPomodoros',
                'updatedAt'
              ])
            )
          );

        allow delete: if isOwner(userId) && isValidId(taskId);
      }
    }
  }
}
